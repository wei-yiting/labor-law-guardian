theme = dark-plus
font-family = "JetBrains Mono Nerd Font"
font-size = 14
font-feature = true
cursor-style = block

window-padding-x = 10
window-padding-y = 10
window-decoration = true
window-background-opacity = 0.95
window-background-blur-radius = 20

mouse-hide-while-typing = true
copy-on-select = clipboard-copy


fps-limit = 120